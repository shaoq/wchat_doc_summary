# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 微信读书代理 API 地址
WEREAD_API_BASE=https://weread.111965.xyz

# 数据库连接字符串 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/wchat.db

# LLM 配置
# 支持任意兼容 Anthropic 协议的平台

# 方案 1: 使用智谱 GLM
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic/
LLM_API_KEY=your-zhipu-api-key
LLM_MODEL=glm-5

# 方案 2: 使用官方 Anthropic Claude
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-xxx
# LLM_MODEL=claude-3-5-haiku-latest

# 请求超时时间 (秒)
REQUEST_TIMEOUT=30

# 最大重试次数
MAX_RETRIES=3

# 每次抓取的文章数量 (1-100)
FETCH_PAGE_SIZE=50

# 日志级别
LOG_LEVEL=INFO
